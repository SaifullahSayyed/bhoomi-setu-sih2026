# Bhoomi Setu — Environment Configuration Template
# ===========================================================================
# Copy this file to .env and set your production secrets.

# JWT Signing Secret for RBAC access tokens (CRITICAL: change for any public/production deployment)
JWT_SECRET=your-secure-random-jwt-secret-key-here-min-32-chars

# Blockchain RPC Provider URL (default: local Hardhat node)
WEB3_PROVIDER_URI=http://127.0.0.1:8545

# API Host & Ports
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
